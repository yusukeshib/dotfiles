# macOS-only formulae and casks
brew "terminal-notifier" if OS.mac?
cask "abue-ammar/tinycast/tinycast" if OS.mac? && MacOS.version >= :tahoe

# After installation, run: gcloud components install gke-gcloud-auth-plugin
cask "gcloud-cli" if OS.mac?

# Tools managed outside Homebrew:
# - babysit: cargo install --path ~/projects/babysit --locked
#   Clone https://github.com/yusukeshib/babysit into ~/projects/babysit first.
#   Keep ~/.cargo/bin ahead of Homebrew in PATH; reinstall after source changes.
# - Rust toolchain: https://rustup.rs, then `rustup component add rust-analyzer`
#   (pi lsp.json and Neovim use ~/.cargo/bin/rust-analyzer).
# - cargo-expand (Neovim <leader>o on a Rust struct): cargo install cargo-expand --locked
# - gh-dash: gh extension install dlvhdr/gh-dash
