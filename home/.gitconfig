[user]
  name = Yusuke Shibata
  email = yusukeshib@gmail.com
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFHU+tFJRax7dVnTEiFM2+kwasijxiQ/GxXm0UqOXTTE

[core]
  # Never block non-interactive callers (agents, scripts) on a pager or editor.
  # Keep this default in interactive shells too; opt in with GIT_EDITOR explicitly.
  pager = cat
  editor = true

[push]
  default = current
  autoSetupRemote = true

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[interactive]
  diffFilter = delta --color-only

# Used when delta is run directly (e.g. `git diff | delta`). Git itself never pages
# through delta (core.pager = cat), and --color-only above keeps `git add -p`
# hunks structurally unchanged, so these layout options do not apply there.
[delta]
  navigate = true  # use n and N to move between diff sections
  line-numbers = true
  side-by-side = true

[merge]
  conflictstyle = zdiff3

[diff]
  colorMoved = default
  algorithm = histogram

[column]
  ui = auto

[init]
  defaultBranch = main

[commit]
  gpgsign = false
  verbose = true

[branch]
  sort = -committerdate

[gpg]
  format = ssh

[gpg "ssh"]
  # Public side of user.signingkey — lets `git log --show-signature` / `git verify-commit`
  # validate ssh-signed commits & tags locally. The SIGNER program (1Password) is set
  # in gitconfig_darwin, which dots links only on macOS; elsewhere ssh-keygen signs.
  allowedSignersFile = ~/.config/git/allowed_signers

[tag]
  # Keep tags lightweight: no forced signing so `git tag <name>` never opens
  # an editor (a signed/annotated tag would require a message). Commits are
  # controlled separately by commit.gpgsign. Sign a tag explicitly with `git tag -s`.
  gpgSign = false

[rerere]
  enabled = true

[pull]
  rebase = true

[fetch]
  prune = true

[rebase]
  autostash = true

[alias]
  dft = "-c diff.external=difft diff"

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# Keep includes last so platform overrides win over the settings above. The file
# comes from home-darwin/ and is absent on other platforms; Git skips a missing
# include.
[include]
  path = ~/.config/git/gitconfig_darwin
