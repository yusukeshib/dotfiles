#!/bin/sh

usage() {
    echo 'Usage: brew-add [--cask|--tap|other brew bundle add options] name [...]'
    echo 'Adds entries to ~/Brewfile, then runs brew-sync (install + cleanup; cleanup asks first on a terminal).'
}

if [ "$#" -eq 0 ]; then
    usage >&2
    exit 1
fi

for arg do
    case "$arg" in
        -h|--help)
            usage
            exit 0
            ;;
        --file|--file=*|-g|--global)
            echo 'brew-add always uses ~/Brewfile; --file and --global are not supported.' >&2
            exit 1
            ;;
    esac
done

# Call the sibling script directly: ~/dotfiles/bin may not be on PATH (e.g. in
# non-interactive shells that skip init.zsh).
brew bundle add --file="$HOME/Brewfile" "$@" &&
    "$(dirname "$0")/brew-sync"
