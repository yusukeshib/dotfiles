#!/bin/sh

usage() {
    echo 'Usage: brew-remove [--formula|--cask|--tap|other brew bundle remove options] name [...]'
    echo 'Removes entries from ~/Brewfile, then runs brew-sync (including cleanup --force).'
}

if [ "$#" -eq 0 ]; then
    usage >&2
    exit 1
fi

for arg do
    case "$arg" in
        -h|--help)
            usage
            exit 0
            ;;
        --file|--file=*|-g|--global)
            echo 'brew-remove always uses ~/Brewfile; --file and --global are not supported.' >&2
            exit 1
            ;;
    esac
done

brew bundle remove --file="$HOME/Brewfile" "$@" &&
    brew-sync
